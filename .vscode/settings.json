{
    "cSpell.words": [
        "checkpointed",
        "checkpointing",
        "defusedxml",
        "docopt",
        "iterparse",
        "langdetect",
        "lastmod",
        "lxml",
        "minidom",
        "noout",
        "structlog",
        "urlset"
    ],
    "cSpell.ignorePaths": [
        "alteryx-help-current-sitemap.xml",
        ".devcontainer/*"
    ],
    "chat.promptFilesRecommendations": {
        "speckit.constitution": true,
        "speckit.specify": true,
        "speckit.plan": true,
        "speckit.tasks": true,
        "speckit.implement": true
    },
    "chat.tools.terminal.autoApprove": {
        ".specify/scripts/bash/": true,
        ".specify/scripts/powershell/": true,
        "/^cd /workspaces/uv-ayx-rag && uv run pytest.*": true,
        "/^cd /workspaces/uv-ayx-rag && uv add.*": true,
        "/^cd /workspaces/uv-ayx-rag/packages/.* && uv run pytest.*": true,
        "/^cd /workspaces/uv-ayx-rag/packages/.* && uv add.*": true
    },
    // Python Testing Configuration
    // Add new package test paths here as you create them:
    // "packages/<package-name>/tests"
    "python.testing.pytestArgs": [
        "tests",
        "packages/sitemap-filter/tests",
        "packages/sitemap-download/tests",
        "packages/url-extractor/tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python-envs.pythonProjects": []
}
